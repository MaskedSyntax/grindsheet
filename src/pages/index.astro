---
import Base from "../layouts/Base.astro";
import GateCard from "../components/GateCard.astro";
import PhaseSection from "../components/PhaseSection.astro";
import Toolbar from "../components/Toolbar.astro";
import { phases, totalTasks } from "../data/roadmap";
import { gateRequirements } from "../data/gate";
import progressScript from "../scripts/progress.js?raw";

const gatePayload = gateRequirements.map((req) => ({
  label: req.label,
  taskIds: req.taskIds,
  atLeast: req.atLeast ?? null,
}));
---

<Base
  title="iOS Job Roadmap"
  description="A checklist for getting job-ready as a junior iOS developer. Progress is saved in this browser."
>
  <header class="hero wrap">
    <p class="eyebrow">Swift · SwiftUI · UIKit</p>
    <h1>Everything I need to do <span class="h1-break"></span>to get hired as an iOS dev.</h1>
    <p class="hero-lede">
      {totalTasks} things worth doing once, in order. Tick them off as you go —
      progress is saved in this browser, and you can export it.
    </p>

    <GateCard />
  </header>

  <div class="status">
    <div class="status-inner">
      <div class="bar"><i data-total-bar></i></div>
      <span class="status-count" data-total-count><b>0</b> of {totalTasks}</span>
      <span class="status-pct" data-total-pct>0%</span>
    </div>
  </div>

  <main class="wrap phases">
    <Toolbar />
    {phases.map((phase) => <PhaseSection phase={phase} />)}
  </main>

  <footer class="foot wrap">
    <p>
      Progress lives in this browser's local storage under
      <code>ios-roadmap.v1</code>. Clearing site data wipes it, so export a
      backup before you do — and to move progress to another device.
    </p>
    <p>Source doc condensed to remove repeated topic lists and anything that wasn't a thing to actually do.</p>
  </footer>

  <script type="application/json" id="gate-data" is:inline set:html={JSON.stringify(gatePayload)} />
  <script is:inline set:html={progressScript} />
</Base>
