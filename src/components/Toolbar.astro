<div class="tools">
  <button class="tool" type="button" data-tool="hide-done" aria-pressed="false">
    Hide completed
  </button>
  <span class="tools-spacer"></span>
  <button class="tool" type="button" data-tool="export">Export</button>
  <button class="tool" type="button" data-tool="import">Import</button>
  <button class="tool" type="button" data-tool="reset">Reset</button>
  <input type="file" accept="application/json,.json" hidden data-import-input />
</div>
<p class="tool-note" data-tool-note role="status" aria-live="polite"></p>
