---
import type { Task } from "../types";

interface Props { task: Task }
const { task } = Astro.props;
---

<div class="row">
  <label class="row-main">
    <input type="checkbox" data-task={task.id} />
    <span class="tick" aria-hidden="true">
      <svg viewBox="0 0 12 12"><path d="M1.5 6.4 4.4 9.3 10.5 3" /></svg>
    </span>
    <span class="row-text">
      <span class="row-label">{task.label}</span>
      {task.note && <span class="row-note">{task.note}</span>}
    </span>
  </label>
  <span class="row-side">
    {task.difficulty && <span class="diff" data-d={task.difficulty}>{task.difficulty}</span>}
    <a
      class="row-link"
      href={task.url}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`Open: ${task.label}`}
    >
      <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 2h7v7M12 2 3 11" />
        <path d="M9.5 12H2V4.5" />
      </svg>
    </a>
  </span>
</div>
