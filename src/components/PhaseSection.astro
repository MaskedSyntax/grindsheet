---
import type { Phase } from "../types";
import { phaseTasks } from "../types";
import ProgressRing from "./ProgressRing.astro";
import TaskItem from "./TaskItem.astro";

interface Props { phase: Phase }
const { phase } = Astro.props;
const total = phaseTasks(phase).length;
const num = String(phase.number).padStart(2, "0");
---

<section class="phase" id={phase.id} data-phase={phase.id}>
  <div class="phase-head">
    <span class="phase-num">PHASE {num}</span>
    <h2>{phase.title}</h2>
    <ProgressRing phaseId={phase.id} />
    <span class="ring-label" data-phase-count={phase.id}>0/{total}</span>
  </div>

  <p class="phase-blurb">{phase.blurb}</p>
  <p class="empty-note">All {total} done. Nothing left in this phase.</p>

  {phase.groups.map((group) => (
    <details class="group" data-group open={!group.collapsed}>
      <summary>
        <span class="group-title">{group.title}</span>
        <span class="group-count" data-group-count>0/{group.tasks.length}</span>
        <svg class="chev" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4.5 2.5 8 6l-3.5 3.5" />
        </svg>
      </summary>
      <div class="group-body">
        {group.blurb && <p class="group-blurb">{group.blurb}</p>}
        <div class="rows">
          {group.tasks.map((task) => <TaskItem task={task} />)}
        </div>
      </div>
    </details>
  ))}
</section>
