---
import { gateRequirements } from "../data/gate";
---

<section class="gate" data-gate data-unlocked="false" aria-labelledby="gate-title">
  <div class="gate-top">
    <h2 class="gate-title" id="gate-title">Application Gate</h2>
    <span class="gate-status" data-gate-status>Locked</span>
  </div>

  <p class="gate-count">
    <span data-gate-done>0</span> <span class="gate-of">/ {gateRequirements.length} cleared</span>
  </p>

  <div class="bar"><i data-gate-bar></i></div>

  <ul class="gate-remaining">
    {gateRequirements.map((req, i) => (
      <li data-gate-req={String(i)} data-met="false">
        <span class="gate-req-label">{req.label}</span>
      </li>
    ))}
  </ul>

  <p class="gate-note" data-gate-note>
    Clear these ten and start applying — while you keep working through the rest.
    Waiting for a full roadmap is how people spend a year not applying.
  </p>
</section>
