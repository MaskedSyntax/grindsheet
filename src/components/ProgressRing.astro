---
interface Props { phaseId: string }
const { phaseId } = Astro.props;
const R = 9;
const C = +(2 * Math.PI * R).toFixed(2);
---

<svg class="ring" data-ring={phaseId} width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
  <circle class="ring-track" cx="12" cy="12" r={R} />
  <circle
    class="ring-fill"
    cx="12"
    cy="12"
    r={R}
    stroke-dasharray={C}
    stroke-dashoffset={C}
    data-circumference={C}
  />
</svg>
